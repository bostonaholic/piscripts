#!/bin/bash

# script/bootstrap: Resolve all dependencies that the application requires to run.

# -e or errexit causes the script to exit immediately if any command returns a non-zero exit status.
set -e

cd "$(dirname "$0")/.."

# Create symbolic link to scripts. Refuse to clobber a real ~/bin directory.
if [ -d "${HOME}/bin" ] && [ ! -L "${HOME}/bin" ]; then
  echo "error: ${HOME}/bin is a real directory, not a symlink. Move it aside and re-run." >&2
  exit 1
fi
ln -sfn "$(pwd)/bin" "${HOME}/bin"

# Install Ghostty terminfo system-wide so tput works under sudo.
if [ -f "${HOME}/.terminfo/g/ghostty" ]; then
  sudo cp "${HOME}/.terminfo/g/ghostty" /usr/share/terminfo/g/
  sudo cp "${HOME}/.terminfo/g/ghostty" /usr/share/terminfo/x/xterm-ghostty
fi
