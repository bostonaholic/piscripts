#!/bin/bash

# -e or errexit causes the script to exit immediately if any command returns a non-zero exit status.
set -e

cd "$(dirname "$0")/.."

# add_cron "<schedule>" "<script-name>": idempotently (re)write one crontab entry
# for bin/<script-name>, piping its output to logger.
add_cron() {
  local schedule="$1" name="$2"
  (crontab -l 2>/dev/null || echo "") | grep -v "bin/${name}" | { cat; echo "${schedule} $(pwd)/bin/${name} 2>&1 | /usr/bin/logger --tag ${name}"; } | crontab -
}

# Update system every Saturday at Midnight
if [ -x bin/update-system ]; then
  add_cron "0 0 * * 6" update-system
fi

# Update Pi-hole every Friday at Midnight
if [ -x "$(command -v pihole)" ]; then
  add_cron "0 0 * * 5" update-pihole
fi

# Reboot Raspberry Pi on the first day of every month at 2am
if [ -x bin/monthly-reboot ]; then
  add_cron "0 2 1 * *" monthly-reboot
fi
