#!/usr/bin/env python3

import time

THERMAL_FILE = "/sys/class/thermal/thermal_zone0/temp"


def main():
    try:
        while True:
            with open(THERMAL_FILE) as f:
                celsius = 0.001 * int(f.read())
            kelvin = celsius + 273.15
            fahrenheit = (celsius * (9.0 / 5.0)) + 32.0

            print(f"\n{time.ctime()}")
            print(f"{int(kelvin)} K")
            print(f"{int(celsius)} C")
            print(f"{int(fahrenheit)} F")

            time.sleep(3)
    except KeyboardInterrupt:
        print("\nExiting...")


if __name__ == "__main__":
    main()
