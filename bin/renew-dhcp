#!/bin/bash

# -e or errexit causes the script to exit immediately if any command returns a non-zero exit status.
# -u or nounset causes the script to exit if it encounters any unset variables.
# -o pipefail sets the exit status of a pipeline to the rightmost command that returns a non-zero exit status, or zero if all commands in the pipeline succeed.
set -euo pipefail

INTERFACE=${1:-eth0}

# Both paths refresh the lease in place without dropping the address, so an SSH
# session dropping mid-way cannot leave the Pi offline.
if systemctl is-active --quiet dhcpcd; then
  # Raspberry Pi OS Bullseye: dhcpcd is the DHCP client. Rebind asks the running
  # daemon to renew its lease (dhcpcd 8.x has --rebind but no --renew).
  sudo dhcpcd --rebind "$INTERFACE"
elif systemctl is-active --quiet NetworkManager; then
  # Raspberry Pi OS Bookworm+: re-activating the interface's active profile bounces
  # it in a single NetworkManager operation without disabling autoconnect.
  CONNECTION=$(nmcli -g GENERAL.CONNECTION device show "$INTERFACE")
  sudo nmcli connection up "$CONNECTION"
else
  echo "renew-dhcp: neither dhcpcd nor NetworkManager is active" >&2
  exit 1
fi
